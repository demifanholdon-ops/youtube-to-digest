# ===========================================
# youtube-digest — API Keys
# Rename this file to .env and fill in your keys.
# NEVER commit .env to git!
# ===========================================

# === YouTube Data API v3 (free) ===
# Get one at: https://console.cloud.google.com/ → Enable YouTube Data API v3
YOUTUBE_API_KEY=your_youtube_api_key_here

# === Supadata API (transcripts) ===
# Sign up at: https://supadata.ai
SUPADATA_API_KEY=your_supadata_api_key_here

# === LLM Backend — fill in the ONE you selected ===
# Anthropic: https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-your-key-here

# DeepSeek: https://platform.deepseek.com
DEEPSEEK_API_KEY=sk-your-deepseek-key-here

# OpenAI: https://platform.openai.com
OPENAI_API_KEY=sk-your-openai-key-here

# Ollama (local) — no key needed, just a running server
# OLLAMA_BASE_URL=http://localhost:11434

# === Email Distribution (if selected) ===
# Gmail: enable 2FA, then create an App Password at https://myaccount.google.com/apppasswords
GMAIL_ADDRESS=your_email@gmail.com
GMAIL_APP_PASSWORD=your_16_char_app_password
EMAIL_RECIPIENT=recipient@example.com

# === Feishu Distribution (if selected) ===
# Create a bot at: https://open.feishu.cn/app
FEISHU_APP_ID=cli_your_app_id
FEISHU_APP_SECRET=your_app_secret
# Folder token where docs will be created (get from folder URL)
FEISHU_PARENT_FOLDER_TOKEN=your_folder_token
# Bot webhook for message card delivery
FEISHU_BOT_WEBHOOK=https://open.feishu.cn/open-apis/bot/v2/hook/your-hook-id

# === Notion Distribution (if selected) ===
# Create an integration at: https://www.notion.so/my-integrations
NOTION_API_KEY=secret_your_notion_key
NOTION_DATABASE_ID=your_database_id

# === RSS Distribution (if selected) ===
# Local path to write the RSS XML file
RSS_OUTPUT_PATH=/path/to/your/digest.xml
RSS_FEED_TITLE=My YouTube Digest
